# ARASTE CAPITAL — hébergement statique (Hostinger : LiteSpeed/Apache + PHP)
# Généré par scripts/build-static.mts : ne pas modifier dans out/, modifier le script.
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType image/avif .avif

# Compression des textes (LiteSpeed et Apache) ; les images et polices sont déjà compressées.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/plain application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Racine : langue du navigateur (français par défaut).
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L]
  RewriteRule ^$ /fr/ [R=302,L]
  # Préfixe de langue en capitales → minuscules.
  RewriteRule ^(FR|Fr|fR)(/.*)?$ /fr$2 [R=308,L]
  RewriteRule ^(EN|En|eN)(/.*)?$ /en$2 [R=308,L]
  # Relais PHP du formulaire (mêmes chemins que la route Node).
  RewriteRule ^api/contact/token/?$ api/token.php [L]
  RewriteRule ^api/contact/?$ api/contact.php [L]
  # Un chemin de page sans barre oblique finale pointe vers son dossier.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /fr/introuvable/index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' php; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|avif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(svg|png|ico|webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
