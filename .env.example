# ---------------------------------------------------------------------------
# ARASTE CAPITAL — configuration d'exemple
# Copier ce fichier en `.env.local` (jamais commité). Aucune de ces valeurs
# n'est exposée au navigateur, sauf celles préfixées par NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# URL publique du site (sans barre oblique finale). Requise pour les URL
# canoniques, les balises hreflang, le sitemap, HSTS et les aperçus de partage.
# Sans elle, canoniques/hreflang/sitemap sont omis et l'aperçu de partage
# pointe vers localhost (sans conséquence tant que le site n'est pas indexé).
# À définir AVANT `next build` : la valeur est figée dans les pages statiques.
NEXT_PUBLIC_SITE_URL=

# Indexation par les moteurs de recherche. Laisser à `false` (préproduction)
# tant que les informations légales ne sont pas validées. `true` = publication.
# Attention : `noindex` n'est pas une protection d'accès. À définir AVANT
# `next build` (pages statiques, robots.txt et en-têtes compilés).
SITE_INDEXABLE=false

# --- Formulaire de contact ---------------------------------------------------
# Fournisseur d'envoi : `none` (mode démonstration, aucun envoi), `resend`
# ou `webhook`. Sans fournisseur configuré, le formulaire annonce clairement
# qu'aucun message n'a été envoyé.
CONTACT_PROVIDER=none

# Secret serveur utilisé pour signer le jeton anti-automatisation du formulaire.
# Générer une valeur aléatoire longue : `openssl rand -hex 32`.
CONTACT_FORM_SECRET=

# Adresse destinataire des demandes (boîte du cabinet) et expéditeur technique.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Fournisseur `resend` : clé API (https://resend.com), côté serveur uniquement.
RESEND_API_KEY=

# Fournisseur `webhook` : URL recevant la demande en JSON (POST) et jeton
# Bearer facultatif. Utile pour un CRM, Make, n8n ou un service interne.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Limitation de débit (par processus). Valeurs par défaut si vides.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10

# Adresse du client pour la limitation de débit.
# TRUSTED_PROXY_HOPS : nombre de mandataires de confiance (CDN, reverse proxy)
# devant l'application ; l'adresse est lue à cette position depuis la droite de
# X-Forwarded-For (0 = ignorer l'en-tête). TRUSTED_IP_HEADER : en-tête posé par
# l'hébergeur (ex. cf-connecting-ip, fly-client-ip), lu en priorité s'il est
# renseigné. Sans adresse fiable, un compartiment partagé à limite élargie s'applique.
TRUSTED_PROXY_HOPS=1
TRUSTED_IP_HEADER=
